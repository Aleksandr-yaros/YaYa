{
  "name": "yaya-journey-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types && npm test && wrangler deploy --dry-run --env staging",
    "types": "wrangler types && tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "dev": "wrangler dev --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.127.1"
  }
}
